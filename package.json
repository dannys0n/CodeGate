{
	"name": "codegate",
	"private": true,
	"version": "1.0.0",
	"description": "A self-discipline coding gate built on the CoJudge offline judge",
	"author": "CodeGate contributors",
	"type": "module",
	"main": "desktop/main.mjs",
	"bin": {
		"cojudge": "./bin/cojudge"
	},
	"scripts": {
		"test": "vitest",
		"test:e2e": "playwright test",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"postinstall": "node -e \"const fs = require('fs'); const path = 'node_modules/@firebase/util/dist/postinstall.mjs'; if (fs.existsSync('node_modules/@firebase/util/dist') && !fs.existsSync(path)) fs.writeFileSync(path, 'export const getDefaultsFromPostinstall = () => undefined;');\"",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"codegate:catalog": "node scripts/codegate/catalog.mjs",
		"codegate:candidates": "node scripts/codegate/catalog.mjs --write",
		"codegate:candidates:ensure": "node scripts/codegate/catalog.mjs --ensure",
		"codegate:export:android": "node scripts/codegate/export-android.mjs",
		"codegate:import:audit": "node scripts/codegate/importer/audit.mjs",
		"codegate:failure-smoke": "node scripts/codegate/failure-smoke.mjs",
		"intellisense:images": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/intellisense.ps1 -Install -Languages cpp,python,java,csharp,rust,go,typescript",
		"importer:test": "vitest run scripts/codegate/importer",
		"desktop": "electron .",
		"desktop:test": "vitest run desktop",
		"desktop:smoke": "electron . --smoke-test",
		"desktop:build": "npm run codegate:candidates:ensure && npm run build && electron-builder --win nsis",
		"startup:enable": "electron . --startup=enable",
		"startup:disable": "electron . --startup=disable",
		"startup:status": "electron . --startup=status"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@types/dockerode": "^3.3.44",
		"electron": "^39.8.10",
		"electron-builder": "^26.15.3",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^3.2.6"
	},
	"build": {
		"appId": "dev.codegate.desktop",
		"productName": "CodeGate",
		"asar": true,
		"npmRebuild": false,
		"asarUnpack": [
			"codegate/candidate-assets.bin",
			"desktop/*.ps1",
			"docker/intellisense/**/*"
		],
		"electronFuses": {
			"runAsNode": false,
			"enableNodeOptionsEnvironmentVariable": false,
			"enableNodeCliInspectArguments": false
		},
		"directories": {
			"output": "dist-desktop",
			"buildResources": "desktop/resources"
		},
		"files": [
			"build/**/*",
			"codegate/candidate-manifest.json",
			"codegate/candidate-assets.bin",
			"courses/**/*",
			"desktop/**/*",
			"docker/intellisense/**/*",
			"problems/**/*",
			"package.json",
			"node_modules/**/*"
		],
		"win": {
			"target": "nsis",
			"icon": "desktop/resources/icon.ico",
			"artifactName": "CodeGate-Setup-${version}.${ext}"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"deleteAppDataOnUninstall": true,
			"installerIcon": "desktop/resources/icon.ico",
			"uninstallerIcon": "desktop/resources/icon.ico",
			"include": "desktop/installer.nsh"
		}
	},
	"dependencies": {
		"dockerode": "^5.0.1",
		"firebase": "^12.6.0",
		"marked": "^16.4.0",
		"monaco-editor": "^0.55.1",
		"monaco-vim": "^0.4.4",
		"qrcode": "^1.5.4",
		"tar-stream": "^3.1.7",
		"uuid": "^13.0.0"
	},
	"overrides": {
		"cookie": "0.7.2",
		"dompurify": "3.4.12"
	}
}
